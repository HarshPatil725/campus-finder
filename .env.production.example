# =========================================================================
# Campus Wi-Fi Monitoring & Incident Management System
# Production Environment Variables Template
# =========================================================================

# Application Server
PORT=3000
NODE_ENV=production

# Managed PostgreSQL Connection String (e.g. Render PostgreSQL, Supabase, Neon, AWS RDS)
# Using SSL is required in production (sslmode=require)
DATABASE_URL=postgresql://campus_admin:<STRONG_PASSWORD>@<DB_HOST>:<DB_PORT>/campus_wifi_db?sslmode=require

# Individual Connection Parameters (Alternative to DATABASE_URL)
DB_HOST=<INTERNAL_DB_HOST_OR_PRIVATE_IP>
DB_PORT=5432
DB_NAME=campus_wifi_db
DB_USER=campus_admin
DB_PASSWORD=<STRONG_PASSWORD>

# Production Administrator Security Controls
REQUIRE_AUTH=true
ADMIN_USERNAME=campus_network_admin
ADMIN_PASSWORD=<STRONG_UNIQUE_ADMIN_PASSWORD>
ADMIN_SALT=<GENERATE_32_CHAR_RANDOM_HEX_SALT>

# Session Expiration (in milliseconds, default 2 hours)
SESSION_TTL_MS=7200000
